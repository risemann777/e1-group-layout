include ../../mixins/form

footer.footer.layout__footer
  .footer__bg.footer__bg--desktop: img(src="images/footer_bg_desktop.png")
  .footer__bg.footer__bg--mobile: img(src="images/footer_bg_mobile.png")
  .footer__connect
    .footer__connect-info
      .footer__connect-cta Стать партнером, задать вопрос, узнать о вакансиях
      .footer__connect-contact
        span Обратитесь к нам на почту
        br
        a(href="mailto:info@e1-group.ru") info@e1-group.ru
    .footer__connect-form
      +form({
        modifiers: ["form--static"],
        common_errors: ["Похоже вы робот!"],
        theme: 'light',
        fields: [
          {
            type: 'text',
            name: 'name',
            label: 'Выше имя',
            placeholder: 'Имя / Огранизация',
            required: false
          },
          {
            type: 'tel',
            name: 'phone',
            label: 'Телефон',
            placeholder: 'Телефон',
            required: true
          },
          {
            type: 'text',
            name: 'email',
            label: 'E-mail',
            placeholder: 'E-mail',
            required: false,
            error: 'Обязательное поле'
          }
        ]
      })
  .footer__middle
    .footer__middle-left
      .footer-address Юридический адрес: 115035, г. Москва, внутригородская территория города федерального значения Муниципальный Округ Якиманка, пер. 3-й Кадашевский, д. 7–9, стр. 1, помещ. 8/1.
      .footer-details
        .footer-details__item
          .footer-details__label ИНН:
          .footer-details__value 9706060150
        .footer-details__item
          .footer-details__label ОГРН:
          .footer-details__value 1257700575274
        .footer-details__item
          .footer-details__label КПП:
          .footer-details__value 770601001
    .footer__middle-right
      .footer-contact
        .footer-contact__item
          .footer-contact__label Телефон:
          .footer-contact__value: a(href="tel:79000000000") +7 (900) 000-00-00
        .footer-contact__item
          .footer-contact__label Почта:
          .footer-contact__value: a(href="mailto:info@e1-group.ru") info@e1-group.ru

  .footer__bottom
    .footer__copyright Copyright © АО «Е1 ГРУПП»
    .footer__links
      a(href="privacy.html") Политика конфиденциальности
      a(href="approve.html") Согласие на обработку персональных данных