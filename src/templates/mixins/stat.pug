mixin stat(data)
  - items = data?.items || null
  - modifiers = data?.modifiers || null
  - strModifier = ''

  if (modifiers && modifiers.length)
    - strModifier = modifiers.join(" ")

  .stat(class=`${strModifier}`)
    if (items && items.length)
      .stat__list
        each item, index in items
          - label = item?.label || 'Label text'
          - value = item?.value || '9999+'
          - term = item?.term || null
          .stat__item
            .stat__label!=label
            .stat__info
              .stat__value!=value
              if term
                .stat__term=term