extends layouts/main/layout
include mixins/stat
include mixins/values
include mixins/sphere
include mixins/brand

block vars
  - layoutMofifiers = 'layout--inner'
  - browserTitle = 'О компании'
  - description = 'О компании Е1-Групп'
  - pageTitle = 'О компании';
  - breadcrumb = [{name: 'О компании'}]
  - headlineText = 'Динамично развивающаяся Группа Компаний, специализирующаяся на производстве и продажах решений для строительства, таких как электроинструмент, строительная техника, садовая техника и IT решений для управления парком средств малой строительной механизации.'

block content
  .page-about
    .page-about__section
      .page-about__container
        +stat({
          items: [
            {
              label: 'Лет на рынке',
              value: '30+'
            },
            {
              label: 'Число сотрудников',
              value: '2000+'
            },
            {
              label: 'Ед. продукции выпускаем в год',
              value: '>2 млн.'
            },
            {
              label: 'Стран присутствия',
              value: '13'
            },
          ]
        })
    .page-about__banner
      .about-banner
        .about-banner__image
          picture
            img(src="images/about-banner-bg-min.jpg")
        .about-banner__container
          .about-banner__content
            .about-banner__title Группа Компаний «Е1-Групп» это команда профессионалов с опытом работы на рынке электроинструментов более 15 лет.
    .page-about__section
      .page-about__container
        .page-about__section-heading
          .page-about__section-title Наша работа построена на профессионализме и представляет работу во множестве сфер
        .page-about__section-content
          +sphere({
            list: [
              {
                icon: 'rocket',
                title: 'Маркетинг',
                text: '<p>Развитие брендов</p><p>Поддержка дилерской сети</p><p>Коммуникация с пользователями напрямую и через лидеров мнений</p>'
              },
              {
                icon: 'boat',
                title: 'Логистика и Операции',
                text: '<p>Эффективная логистика в партнерстве с Noytech Logistics Rus</p><p>Цифровизация всех процессов оформления заказов</p>',
              },
              {
                icon: 'headset',
                title: 'Сервисная поддержка',
                text: '<p>Компактная и эффективная сеть сервисных центров</p><p>Доступ к быстрой сервисной поддержке для всех пользователей  через «Сервис-Онлайн)</p><p>Дополнительные сервисные программы – Полная Гарантия, Подменный фонд и другие.</p>',
                big: true
              },
              {
                icon: 'memory',
                title: 'IT решения',
                text: 'Программа по управлению парком средств малой  строительной механизации на базе RFID меток и программного обеспечения от Softline'
              },
              {
                icon: 'coins',
                title: 'Финансовые услуги',
                text: 'Программа по лизингу парка электроинструментов для крупных конечных пользователей'
              }
            ]
          })

    .page-about__section
      .page-about__container
        .page-about__section-heading
          .page-about__section-title Наши ценности — основа нашей деятельности
          .page-about__section-description Компания Е1-Групп всегда уделяла особое внимание приверженности ценностям. Они отражают наши принципы ведения бизнеса: наша профессиональная этика в отношениях с деловыми партнерами, инвесторами, сотрудниками и обществом.
        .page-about__section-content
          +values({
            list: [
              {
                title: 'Нацеленность на результат',
                text: 'Наши действия ориентированы на результат, что гарантирует процветание компании. Это также создает основу для социальных инициатив и работы благотворительного фонда.'
              },
              {
                title: 'Инициативность и решительность',
                text: 'Мы действуем по собственной инициативе, осознавая ответственность за деятельность, и последовательны в достижении целей.'
              },
              {
                title: 'Ответственность и устойчивое развитие',
                text: 'Мы действуем взвешенно и ответственно на благо общества и окружающей среды.'
              },
              {
                title: 'Открытость и доверие',
                text: 'Мы своевременно и открыто информируем о важных событиях в компании. Это основа доверительного сотрудничества.'
              },
              {
                title: 'Надежность, доверие и законность',
                text: 'Мы обещаем только то, что можем выполнить, считаем обещания обязательствами, уважаем и соблюдаем права и законы в осуществлении всех наших бизнес-операций.'
              },
              {
                title: 'Честность',
                text: 'Взаимная честность – условие нашего корпоративного успеха в отношениях друг с другом и с деловыми партнерами.'
              }
            ]
          })


    .page-about__section
      .page-about__container
        .page-about__section-heading
          .page-about__section-title Бренды в Группе Компаний «Е1-Групп»
        .page-about__section-content
          +brand({
            list: [
              {
                logo: 'images/brands/brand_dong_cheng.png',
                description: '<p>Эксклюзивный дистрибутор бренда DongCheng (DongCheng Professional Power Tools) на Российском рынке.</p>',
                link: 'www.dongchengtool.ru'
              },
              {
                logo: 'images/brands/brand_engels.png',
                description: '<p>Профессиональная линейка инструмента, сделанного в России, с высоким уровнем локализации и повышенным ресурсом на базе бывшего завода Бош в г. Энгельс.</p>',
                link: 'engelstool.ru'
              },
              {
                logo: 'images/brands/brand_dfc.png',
                description: '<p>Поставщик строительного оборудования, электроинструментов, садово-парковой техники и сервисных услуг.</p>',
                link: 'dctool.ru'
              },
            ]
          })

    .page-about__section
      .page-about__container
        .page-about__section-heading
          .page-about__section-title Стратегические партнеры
        .page-about__section-content
          +brand({
            columnsCount: 2,
            list: [
              {
                logo: 'images/brands/brand_noytech.png',
                description: '<p>Эксклюзивный дистрибутор бренда DongCheng (DongCheng Professional Power Tools) на Российском рынке.</p>',
                link: 'www.dongchengtool.ru'
              },
              {
                logo: 'images/brands/brand_softline.png',
                description: '<p>Профессиональная линейка инструмента, сделанного в России, с высоким уровнем локализации и повышенным ресурсом на базе бывшего завода Бош в г. Энгельс.</p>',
                link: 'engelstool.ru'
              },
            ]
          })
        .page-about__section-bottom
          .cta-panel
            .cta-panel__decor: img(src="images/cta_panel_decor.svg")
            .cta-panel__info
              .cta-panel__title Хотите стать нашим партнером?
              .cta-panel__text Мы открыты для новых идей и совместных проектов — свяжитесь с нами!
            .cta-panel__button: button(type="button" class="btn btn--secondary" data-toggle="modal" data-target="#contactModal") Обсудить сотрудничество
    include modules/section-career
