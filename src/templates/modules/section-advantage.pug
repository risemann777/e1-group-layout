include ../mixins/solution

section.advantage(id="advantage")
  .advantage__container
    .advantage__col
      .advantage__info
        .advantage__logo: img(src="images/logo_writing_black.svg")
        .advantage__description Динамично развивающаяся Группа Компаний,  специализирующаяся на производстве и продажах решений для  строительства, таких как электроинструмент, строительная  техника, садовая техника и IT решений для управления парком средств малой строительной механизации.
      .advantage__controls
        a(href="#products" class="btn btn--primary" data-smooth-scroll=true) Продукция и услуги
        button(type="button" class="btn btn--outline-primary" data-toggle="modal" data-target="#contactModal") Связаться с нами
    .advantage__col
      +solution({
        title: 'Наши решения:',
        description: 'Динамично развивающаяся Группа Компаний,  специализирующаяся на производстве и продажах решений для  строительства, таких как электроинструмент, строительная  техника, садовая техника и IT решений для управления парком средств малой строительной механизации.',
        list: [
          {
            name: 'IT Решения',
            text: 'Решения для управления парком средств малой строительной механизации'
          },
          {
            name: 'Дистрибуция',
            text: 'Работа с крупнейшими игроками рынка электроинструментов и крупными конечными потребителями'
          },
          {
            name: 'Операционная  модель',
            text: 'Эффективная логистика и партнерство с NOYTECH. Опытная команда и производственная экспертиза'
          },
          {
            name: 'Пользователи',
            text: 'Продуктовый портфель, покрывающий потребности широкого круга пользователей от DIY энтузиастов до B2G'
          }
        ]
      })