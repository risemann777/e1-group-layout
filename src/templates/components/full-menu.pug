include ../mixins/mobile-nav

.full-menu.full-menu--fall
  .full-menu__bg(data-toggle="menu")
  .full-menu__panel
    .full-menu__wrapper
      .full-menu__container
        .full-menu__mobile
          .mobile-menu
            .mobile-menu__body
              +mobile-nav({
                list: [
                  {
                    name: 'Продукция и услуги',
                    href: 'products.html',
                    smoothScroll: false,
                    sublist: [
                      {name: 'ЭНГЕЛЬС', href: 'https://engelstool.ru', target: '_blank'},
                      {name: 'DongCheng', href: 'https://dongchengtool.ru', target: '_blank'},
                      {name: 'Distribution for Construction', href: 'https://dctool.ru', target: '_blank'},
                    ]
                  },
                  {
                    name: 'Партнеры',
                    href: '/#partnership',
                    smoothScroll: true
                  },
                  {
                    name: 'О компании',
                    href: 'about.html',
                    smoothScroll: false
                  },
                  {
                    name: 'Карьера',
                    href: '#career',
                    smoothScroll: true
                  },
                  {
                    name: 'Медиа',
                    href: 'news.html',
                    smoothScroll: false
                  },
                  {name: 'Контакты', href: 'contacts.html', smoothScroll: false},
                ]
              })
            .mobile-menu__bottom
              // .mobile-menu__phone
                a(href="tel:+7 (499) 111-22-33"): span +7 (499) 111-22-33
              button(class="btn btn--primary full-menu__button" data-toggle='modal' data-target="#contactModal") Свяжитесь с нами
        .full-menu__desktop(style="background-image:url(images/menu_logo.svg)")
          .product-menu
            ul.product-menu__list
              li.product-menu__item: a(href="https://engelstool.ru" target="_blank").product-menu__link ЭНГЕЛЬС
              li.product-menu__item: a(href="https://dongchengtool.ru" target="_blank").product-menu__link DongCheng
              li.product-menu__item: a(href="https://dctool.ru" target="_blank").product-menu__link Distribution for Construction

