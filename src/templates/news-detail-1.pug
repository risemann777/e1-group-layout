extends layouts/main/layout
include mixins/error-page

block vars
  - layoutMofifiers = 'layout--inner layout--hidden-title'
  - browserTitle = 'Страница 404'
  - description = 'Адрес и телефон компании FranzLift поставщика лифтов по РФ'
  - pageTitle = 'Страница 404';
  - breadcrumb = [{name: 'Страница 404'}]
  - notShowPageTitle = true
  - notShowHeadline = "Y"

block content
  .news-detail
    .news-detail__section
      .news-detail__container
        .news-detail__date
        .news-detail__content
          h1 «ЭНГЕЛЬС» вместо Bosch: в Саратовской области возрождается производство отечественного профессионального электроинструмента
          p «ЭНГЕЛЬС» вместо Bosch: в Саратовской области возрождается производство отечественного профессионального электроинструмента
          p 25 февраля 2026 года завод ООО «Энгельс Электроинструменты» вошёл в состав активов холдинга АО «Е1 Групп». АО «Е1 Групп» нацелено на расширение производства профессионального электроинструмента на базе завода в г. Энгельс, а также развитие производственно-технической платформы завода при поддержке инвестиционно-технологического холдинга ПАО «Софтлайн» (партнер в области ИТ-инфраструктуры и технических решений), широкой сети дистрибуции компании Distribution for Construction (эксклюзивный дистрибьютер бренда DongCheng – лидера профессионального электроинструмента на рынке Китая) и лидера комплексных логистических решений NOYTECH Supply Chain Solutions.
          p Завод сохранил технологические и производственные компетенции. Сейчас предприятие состоит из 210 сотрудников, 96% которых были сотрудниками международного концерна Bosch.
          p Стратегия развития предусматривает создание новых рабочих мест в Саратовской области, что внесет значительный вклад в развитие региона. Кроме того, локализация производства позволяет сократить логистические издержки и сроки поставок для российских заказчиков, обеспечит комплектующие и запчасти для обслуживания и ремонта электроинструмента для стабильной работы потребителей продукции по всей России.
          h2 Создание нового промышленного кластера
          p Производственные мощности, расположенные на территории г. Энгельс Саратовской области с августа 2025 года, выпускают профессиональный электроинструмент под брендом «ЭНГЕЛЬС». Продукция ориентирована на профессиональных пользователей, для которых функциональность, надежность и качество инструмента имеют первоочередное значение, а также на крупных корпоративных клиентов и государственных заказчиков в области ремонта, строительства и промышленности. Среди ключевых потребителей — ведущие строительные и девелоперские компании, отраслевые и добывающие предприятия страны.
          p: i «Вхождение завода в холдинг АО «Е1 Групп» и партнерская поддержка отраслевых лидеров в сочетании с нашим многолетний опытом производства электроинструмента в составе международного концерна Bosch  — это новый импульс для развития предприятия и создания конкурентоспособной отечественной продукции мирового уровня, — отмечает Сергей Закора, генеральный директор ООО «Энгельс Электроинструменты». — команда завода будет и в дальнейшем вносить свой вклад в развитие производства электроинструмента в России и повышению нашего технологического суверенитета.»
    .news-detail__bottom
      .news-detail__container
        .news-detail__social
          .social
            .social__title Наши соц. сети:
            .social__list
              a(href="https://vk.ru").social__item: img(src="images/social/social_vk.svg")
              a(href="https://vk.ru").social__item: img(src="images/social/social_tg.svg")
              a(href="https://vk.ru").social__item: img(src="images/social/social_max.svg")
